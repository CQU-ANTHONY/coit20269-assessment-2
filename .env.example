# Root env for Docker Compose. Copy to .env and adjust. NEVER commit .env
# Used by compose variable substitution (docker compose reads this file automatically).

# JWT signing secret for the API container.
# Default in compose.yml is a dev-only placeholder — override it here.
JWT_SECRET=dev-only-secret-change-me

# Host port for the API container (container listens on 3000).
# 3100 avoids clashing with other projects on port 3000.
API_HOST_PORT=3100

# Host port for MongoDB (container listens on 27017).
MONGO_HOST_PORT=27017
