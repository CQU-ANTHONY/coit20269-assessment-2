# Copy to .env and fill in real values. NEVER commit .env
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studyswap
JWT_SECRET=change-me-to-a-long-random-string

# Local HTTPS (optional). Generate with: node scripts/generate-dev-cert.js
# Paths are relative to the server/ directory.
# On Render, leave unset — TLS is terminated by the platform.
# HTTPS_KEY_PATH=certs/dev-key.pem
# HTTPS_CERT_PATH=certs/dev-cert.pem
