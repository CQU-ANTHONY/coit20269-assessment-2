<?xml version='1.0' encoding='utf-8'?>
<widget id="au.edu.cqu.studyswap" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>StudySwap</name>
    <description>
        Student second-hand marketplace for CQU (COIT20269 Assignment 2, Group D).
    </description>
    <author email="nauijohn@cqu.edu.au" href="https://github.com/CQU-ANTHONY/coit20269-assessment-2">
        StudySwap Group D
    </author>
    <content src="index.html" />

    <!-- Local www assets + HTTPS API (Render / local HTTPS) -->
    <access origin="https://*" />
    <access origin="http://localhost:*" />
    <access origin="http://127.0.0.1:*" />
    <allow-navigation href="https://*/*" />
    <allow-navigation href="http://localhost:*/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="none" />

    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="SplashScreenDelay" value="0" />
        <allow-intent href="market:*" />
    </platform>
</widget>
